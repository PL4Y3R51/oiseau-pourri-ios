    "charter_1_body": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est toi qui choisis où tu colles - et c'est à toi de t'informer, avant chaque pose, si coller à cet endroit est autorisé ou non. Oiseau pourri n'est en aucun cas responsable de tes collages."
          }
        }
      }
    },
