    "release_0_1_items.0": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vraie app Android : connexion, inscription et ton compte habituel."
          }
        }
      }
    },
    "release_0_1_items.1": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème sombre ou clair au choix, et quatre icônes d'app à choisir dans les Réglages."
          }
        }
      }
    },
    "release_0_1_items.2": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte, la chasse et la pose d'oiseaux, ta collection, tes badges et le classement, en natif."
          }
        }
      }
    },
    "release_0_1_items.3": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans réseau, tes trouvailles et tes poses sont gardées au chaud et partent toutes seules dès qu'il revient."
          }
        }
      }
    },
    "release_0_1_items.4": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification quand quelqu'un trouve un de tes oiseaux."
          }
        }
      }
    },
    "release_0_1_items.5": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens oiseaupourri.ch, ceux de nos e-mails compris, s'ouvrent directement dans l'app."
          }
        }
      }
    },
    "release_0_1_title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oiseau pourri arrive sur Android"
          }
        }
      }
    },
    "release_0_2_items.0": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les badges font peau neuve, en trois familles : à paliers (bronze, argent, or, platine, puis Maître), exploits, et badges uniques qui n’existent qu’en un exemplaire au monde."
          }
        }
      }
    },
    "release_0_2_items.1": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveaux badges uniques pour les poses : le 1er, le 10e, le 25e… oiseau pourri posé dans le monde."
          }
        }
      }
    },
    "release_0_2_items.2": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un badge pour ouvrir sa page : combien de joueurs à chaque palier, qui l’a eu en premier, ou la plaque d’un badge unique."
          }
        }
      }
    },
    "release_0_2_items.3": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sets à compléter (Horloge pourrie, Quatre saisons, Altitude) : un set complet débloque un badge surprise."
          }
        }
      }
    },
    "release_0_2_items.4": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveaux badges : Sommet, Alpage et Abysses selon l’altitude de tes poses, et Oiseau à succès, Oiseau culte et Indestructible quand tes oiseaux font carrière."
          }
        }
      }
    },
    "release_0_2_items.5": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque badge donne un titre : choisis celui qui s’affiche sous ton nom, dans le classement et sur tes oiseaux."
          }
        }
      }
    },
    "release_0_2_items.6": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrine : épingle tes 3 badges préférés en haut de ton profil."
          }
        }
      }
    },
    "release_0_2_items.7": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourrisseur du mois et Chasseur du mois : à la fin de chaque mois, le premier du classement remporte le badge. Le classement s’ouvre sur le mois en cours, avec le premier couronné et les jours restants ; la période « semaine » disparaît."
          }
        }
      }
    },
    "release_0_2_items.8": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app demande au démarrage l’autorisation de t’envoyer des notifications, pour ne rater aucune trouvaille de tes oiseaux."
          }
        }
      }
    },
    "release_0_2_title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Badges : titres, sets et Pourrisseur du mois"
          }
        }
      }
    },
    "release_0_3_items.0": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’oiseau pourri se recentre sur ce qui compte : poser des oiseaux, les chercher, les trouver."
          }
        }
      }
    },
    "release_0_3_items.1": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les badges, les titres, la vitrine et le parrainage disparaissent. Ton profil montre combien d’oiseaux tu as posés et trouvés, et les oiseaux que tu as posés."
          }
        }
      }
    },
    "release_0_3_items.2": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un profil, les oiseaux en couleur sont ceux que tu as trouvés. Touche-en un pour le voir en grand, puis « Voir sur la carte »."
          }
        }
      }
    },
    "release_0_3_items.3": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo est désormais demandée pour poser un oiseau."
          }
        }
      }
    },
    "release_0_3_items.4": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle allure : noir, blanc, jaune fluo et rose, une nouvelle typo, des boutons en relief comme des stickers et des icônes d’app en rose ou en jaune. Un seul thème, clair."
          }
        }
      }
    },
    "release_0_3_title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour à l’essentiel"
          }
        }
      }
    },
